# ============================================================
# Frontend environment variables (copy to .env and fill in)
# ============================================================

# Base URL of the backend API.
# Leave unset in development so the Vite proxy (/api) is used.
# Set it to the deployed API URL for a production build.
VITE_API_BASE_URL=/api

# Target the Vite dev-server proxy forwards /api to (development only)
VITE_API_PROXY=http://localhost:8080

# ============================================================
# Backend environment variables (copy to .env and fill in)
# ============================================================

# Server
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/railway_reservation?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173
